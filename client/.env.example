# Public, non-secret build-time settings. Anything prefixed VITE_ is embedded in the
# browser bundle — NEVER put passwords, tokens or API keys here.

# Production URL of the site (no trailing slash). Enables canonical URLs, og:url and sitemap.xml.
# Leave blank until the real domain is known; no domain is invented.
VITE_SITE_URL=

# Base URL of the API when it is hosted on a different origin (e.g. https://api.example.com).
# Leave blank when the API is served from the same origin (or proxied at /api).
VITE_API_BASE_URL=

# Optional profile links. Leave blank to hide them — nothing is invented.
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_LOCATION=

# Set to "true" only if you want the "Open to Professional Opportunities" status label shown.
VITE_SHOW_AVAILABILITY=false

# Optional absolute URL of a 1200x630 social-sharing image (PNG/JPG).
VITE_OG_IMAGE_URL=

# Dev server proxy target for /api (default http://localhost:4000)
VITE_DEV_API_TARGET=

# Set to "true" to never show the animated intro, giving the fastest possible first paint.
# (By default the intro only appears when loading is slow, once per session, and never for reduced-motion users.)
VITE_DISABLE_INTRO=
