# ---------------------------------------------------------------------------
# Copy to server/.env and fill in real values. NEVER commit server/.env.
# Placeholders below are safe examples only.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# REQUIRED — PostgreSQL connection string (use your managed database URL in production)
DATABASE_URL=postgresql://portfolio:change_me@localhost:5432/portfolio

# Comma-separated list of exact frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the server (hosting platforms usually need 1).
# Required for rate limiting to see real client IPs in production.
TRUST_PROXY=0

# Set true to let this Node service also serve the built React app (single-service deploys)
SERVE_CLIENT=false
CLIENT_DIST_DIR=../client/dist

# ---- Contact form rate limiting (per IP) ----
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15

# ---- E-mail notifications (all three of HOST / NOTIFICATION / FROM enable it) ----
# Leave blank to store messages without e-mail; notifications stay PENDING and are
# delivered automatically once SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=
# Per-phase SMTP timeout in ms (connection / greeting / socket). Bounds how long a request can wait on
# the single delivery attempt made before replying. Range 1000-60000.
SMTP_TIMEOUT_MS=8000
# Optional automatic "your message was received" e-mail to the visitor (off by default)
CONTACT_SEND_ACKNOWLEDGEMENT=false

# ---- Notification retry outbox ----
NOTIFICATION_RETRY_INTERVAL_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=8

# ---- Optional admin API (disabled when blank). Generate: openssl rand -hex 32 ----
ADMIN_API_TOKEN=

SITE_NAME=Shivam Patel Portfolio
